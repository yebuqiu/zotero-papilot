{
  "manifest_version": 3,
  "name": "Papilot 学术阅读侧边栏",
  "version": "0.2.0",
  "description": "学术论文阅读助手：划词解释与翻译、整页段落对照、结构化摘要、摘录本，支持网页与 PDF。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开 Papilot 阅读侧边栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/panel.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://pp.xinglintools.top/*",
    "https://*.sciencedirect.com/*",
    "https://*.springer.com/*",
    "https://*.nature.com/*",
    "https://*.science.org/*",
    "https://*.wiley.com/*",
    "https://*.tandfonline.com/*",
    "https://*.sagepub.com/*",
    "https://ieeexplore.ieee.org/*",
    "https://dl.acm.org/*",
    "https://*.arxiv.org/*",
    "https://*.ncbi.nlm.nih.gov/*",
    "https://*.europepmc.org/*",
    "https://*.plos.org/*",
    "https://*.mdpi.com/*",
    "https://*.frontiersin.org/*",
    "https://*.cell.com/*",
    "https://*.jstor.org/*",
    "https://*.cambridge.org/*",
    "https://*.oup.com/*",
    "https://*.cnki.net/*",
    "https://*.wanfangdata.com.cn/*",
    "https://*.cqvip.com/*",
    "https://xueshu.baidu.com/*",
    "https://*.semanticscholar.org/*",
    "https://*.openreview.net/*",
    "https://*.biorxiv.org/*",
    "https://*.medrxiv.org/*",
    "https://*.ssrn.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.sciencedirect.com/*",
        "https://*.springer.com/*",
        "https://*.nature.com/*",
        "https://*.science.org/*",
        "https://*.wiley.com/*",
        "https://*.tandfonline.com/*",
        "https://*.sagepub.com/*",
        "https://ieeexplore.ieee.org/*",
        "https://dl.acm.org/*",
        "https://*.arxiv.org/*",
        "https://*.ncbi.nlm.nih.gov/*",
        "https://*.europepmc.org/*",
        "https://*.plos.org/*",
        "https://*.mdpi.com/*",
        "https://*.frontiersin.org/*",
        "https://*.cell.com/*",
        "https://*.jstor.org/*",
        "https://*.cambridge.org/*",
        "https://*.oup.com/*",
        "https://*.cnki.net/*",
        "https://*.wanfangdata.com.cn/*",
        "https://*.cqvip.com/*",
        "https://xueshu.baidu.com/*",
        "https://*.semanticscholar.org/*",
        "https://*.openreview.net/*",
        "https://*.biorxiv.org/*",
        "https://*.medrxiv.org/*",
        "https://*.ssrn.com/*"
      ],
      "js": [
        "src/lib/text.js",
        "src/content/selection.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "打开/聚焦 Papilot 阅读侧边栏"
    }
  }
}
